# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=
# Числовой Telegram ID администратора (узнать можно у @userinfobot)
ADMIN_ID=
# Публичный HTTPS-адрес Mini App. Оставьте пустым, если каталог не нужен.
WEBAPP_URL=
# Включить ИИ-консультанта: true или false
AI_ENABLED=false
# API-ключ ИИ-провайдера (например, Groq)
AI_API_KEY=
# Совместимый с OpenAI адрес API
AI_BASE_URL=https://api.groq.com/openai/v1
# Название модели ИИ
AI_MODEL=llama-3.1-8b-instant
# Порт веб-сервера для облачного хостинга (необязательно)
PORT=8080
